{
  "name": "astermux",
  "version": "0.1.2",
  "description": "Adaptive model gateway for Cursor ACP with OpenAI/Anthropic compatibility, universal model pooling, tools, batching, and elastic memory.",
  "private": false,
  "type": "module",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "ui",
    "docs",
    "scripts/astermux",
    "package.json",
    "LICENSE",
    "SECURITY.md"
  ],
  "main": "./dist/sdk/client.js",
  "types": "./dist/sdk/client.d.ts",
  "exports": {
    ".": {
      "types": "./dist/sdk/client.d.ts",
      "import": "./dist/sdk/client.js",
      "default": "./dist/sdk/client.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "astermux": "dist/entry/cli.js"
  },
  "scripts": {
    "prepare": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "start": "node ./dist/entry/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "astermux",
    "cursor",
    "acp",
    "mcp",
    "openai",
    "anthropic",
    "llm",
    "gateway",
    "tool-calling",
    "batch"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "chrome-launcher": "^1.2.1"
  },
  "author": "AsterMux contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiddy1911/AsterMux.git"
  },
  "homepage": "https://github.com/kiddy1911/AsterMux#readme",
  "bugs": {
    "url": "https://github.com/kiddy1911/AsterMux/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
