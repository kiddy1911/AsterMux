# Optional: protect the proxy so only your services can call it
# ASTERMUX_API_KEY=your-secret-key

# Optional: Cursor access token for spawned agent/ACP (automation). Alias: CURSOR_AUTH_TOKEN
# CURSOR_API_KEY=

# Optional: Cursor CLI path (default: agent)
# CURSOR_AGENT_BIN=agent

# Optional: bind and port
# ASTERMUX_HOST=127.0.0.1
# ASTERMUX_PORT=8765

# Optional: workspace base for Cursor CLI (default: current working directory).
# When ASTERMUX_CHAT_ONLY_WORKSPACE=false, X-AsterMux-Workspace must be under this directory.
# ASTERMUX_WORKSPACE=/path/to/your/project

# Ignored — proxy is always chat-only (ask mode); documented for discoverability only.
# ASTERMUX_MODE=ask

# Optional: default model when request doesn't specify one
# ASTERMUX_DEFAULT_MODEL=auto

# Optional: timeout per completion in ms
# ASTERMUX_TIMEOUT_MS=300000
# Chat/Anthropic external tools reconstruct each HTTP turn from request history by default.
# Responses API keeps stateful previous_response_id continuation semantics.
ASTERMUX_TOOL_SESSION_MODE=stateless
# Legacy stateful parked-turn settings only:
ASTERMUX_TOOL_SESSION_TTL_MS=60000
ASTERMUX_TOOL_SESSION_MAX_PER_OWNER=4
ASTERMUX_TOOL_SESSION_MAX_GLOBAL=16
# Optional comma-separated one-shot output functions. These return tool_calls
# without parking an MCP session for a later tool_result.
ASTERMUX_STATELESS_TOOL_NAMES=
ASTERMUX_STATELESS_REPAIR_RETRIES=1

# Optional persistent asynchronous batch queue. Batch requests are stored under
# data/batches and execute through the dedicated ACP batch lane.
ASTERMUX_BATCH_ENABLED=false
ASTERMUX_BATCH_DIR=data/batches
ASTERMUX_BATCH_CONCURRENCY=8
ASTERMUX_BATCH_MAX_REQUESTS=1000
ASTERMUX_BATCH_MAX_JOBS=100
# Terminal job metadata/results are retained for 72 hours by default.
ASTERMUX_BATCH_RETENTION_MS=259200000

# Optional: enable Cursor Max Mode (larger context, more tool calls). Works when using
# CURSOR_AGENT_NODE/SCRIPT or Windows .cmd layout (agent.cmd with node.exe + index.js in same dir).
# ASTERMUX_MAX_MODE=true

# Optional: pool of configuration directories for multiple accounts (comma-separated).
# Auto-discovers ~/.astermux/accounts when unset.
# ASTERMUX_ACCOUNT_DIRS=/Users/alice/Library/Application Support/cursor-agent,/Users/bob/Library/Application Support/cursor-agent

# Optional: when true and ASTERMUX_ACCOUNT_DIRS is set, run each account on a separate port
# ASTERMUX_MULTI_PORT=true

# Optional: send prompt via stdin instead of argv (Windows-friendly)
# ASTERMUX_PROMPT_VIA_STDIN=true

# Optional: use ACP over stdio (agent acp) — avoids Windows argv limits
# ASTERMUX_USE_ACP=false
# When CURSOR_API_KEY is set, authenticate is skipped unless you force:
# ASTERMUX_ACP_SKIP_AUTHENTICATE=true
# Raw JSON-RPC logging (needs NODE_DEBUG=astermux:acp)
# ASTERMUX_ACP_RAW_DEBUG=false

# Optional: Windows CreateProcess cmdline budget for prompt truncation
# ASTERMUX_WIN_CMDLINE_MAX=30000
# CURSOR_AGENT_NODE=C:\Program Files\nodejs\node.exe
# CURSOR_AGENT_SCRIPT=C:\path\to\agent\index.js

# Optional: TLS (e.g. Tailscale)
# ASTERMUX_TLS_CERT=
# ASTERMUX_TLS_KEY=

# Optional: request / traffic logging
# ASTERMUX_SESSIONS_LOG=~/.astermux/sessions.log
# ASTERMUX_VERBOSE=false

# Optional ACP fast path. Physical workers are model-agnostic: each isolated
# ask-mode request selects its model per ACP session, so all supported models
# share the same hot pools. Set a lane size to 0 to disable that pool.
ASTERMUX_USE_ACP=false
ASTERMUX_ACP_POOL_SIZE=0
# Optional separate lane for long-running batch/stateless structured output.
ASTERMUX_ACP_BATCH_POOL_SIZE=8
# Optional elastic warm floors. -1 keeps legacy behavior (warm == max).
# Workers above the floor are created on demand up to *_POOL_SIZE and retire
# after ASTERMUX_ACP_ELASTIC_IDLE_MS. This preserves peak concurrency while
# reducing idle RSS; the first burst after shrink pays worker warm-up once.
ASTERMUX_ACP_INTERACTIVE_WARM_SIZE=-1
ASTERMUX_ACP_BATCH_WARM_SIZE=-1
ASTERMUX_ACP_ELASTIC_IDLE_MS=120000
ASTERMUX_ACP_INTERACTIVE_QUEUE_MAX=4
ASTERMUX_ACP_BATCH_QUEUE_MAX=24
ASTERMUX_ACP_INTERACTIVE_QUEUE_TIMEOUT_MS=15000
ASTERMUX_ACP_BATCH_QUEUE_TIMEOUT_MS=70000
# Optional bounded warm ACP connection pool for external Tool turns.
# For a 2 CPU / 4 GiB host, 2 was validated with large 65-tool requests.
ASTERMUX_ACP_TOOL_POOL_SIZE=0
ASTERMUX_ACP_TOOL_WARM_SIZE=-1
ASTERMUX_ACP_TOOL_QUEUE_MAX=8
ASTERMUX_ACP_TOOL_QUEUE_TIMEOUT_MS=120000
ASTERMUX_ACP_POOL_MAX_REQUESTS=100
ASTERMUX_ACP_POOL_MAX_AGE_MS=3600000

# Isolated temp workspace (default true). Set false only if the CLI should see real paths.
# ASTERMUX_CHAT_ONLY_WORKSPACE=true

# --- docker-compose only (ignored when running outside compose) ---
# Which host interface to bind. Default 127.0.0.1 (localhost only).
# Set to 0.0.0.0 to expose on all interfaces (LAN/Tailscale/public).
# Set to a specific IP (e.g. 100.x.x.x) to bind only that interface.
# ASTERMUX_BIND_ADDR=127.0.0.1
# Host port to expose (container always listens on 8765 internally).
# ASTERMUX_PUBLISH_PORT=8765
